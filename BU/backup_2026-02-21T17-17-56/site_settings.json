    "id": 149,
    "key": "content_footer",
    "value": "{\"about\":{\"title\":\"ميلادك\",\"description\":\"منصة ذكية لحساب العمر بدقة واكتشاف إحصاءات ممتعة عن حياتك. اكتشف كم عشت من الأيام والساعات والدقائق!\"},\"quickLinks\":[{\"href\":\"/\",\"label\":\"الرئيسية\"},{\"href\":\"/#calculator\",\"label\":\"احسب عمرك\"},{\"href\":\"/articles\",\"label\":\"المقالات\"},{\"href\":\"/contact\",\"label\":\"اتصل بنا\"}],\"legalLinks\":[{\"href\":\"/about\",\"label\":\"عن الموقع\"},{\"href\":\"/privacy\",\"label\":\"سياسة الخصوصية\"},{\"href\":\"/terms\",\"label\":\"الشروط والأحكام\"},{\"href\":\"/sitemap.xml\",\"label\":\"خريطة الموقع\"}],\"contact\":{\"email\":\"info@miladak.com\",\"phone\":\"+20 123 456 7890\",\"address\":\"القاهرة، مصر\"},\"social\":{\"facebook\":\"#\",\"twitter\":\"#\",\"instagram\":\"#\",\"youtube\":\"#\"},\"copyright\":\"© {year} ميلادك. جميع الحقوق محفوظة. صُنع بـ ❤️ في مصر - تطوير ميديابايت\"}",
